# Choose one option. Both Python examples load this file automatically.
# Shared model (used by either option)
GOOGLE_GENAI_MODEL="gemini-3.8-flash"

# Option A: Gemini Developer API — easiest start
GEMINI_API_KEY="AQ.Ab8RN6LZCw-"

# Option B: Vertex AI — only needed for the service-account example
GOOGLE_CLOUD_PROJECT="lmu-hackathon-dev-2926"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/outside/this/repo/key.json"

# Discogs API (required for live lookup calls)
DISCOGS_TOKEN="PASTE_YOUR_DISCOGS_PERSONAL_ACCESS_TOKEN"
DISCOGS_USER_AGENT="LMUTracklistHackathon/1.0"

# Docker Compose PostgreSQL & API
POSTGRES_USER="tracklist"
POSTGRES_PASSWORD="tracklist"
POSTGRES_DB="tracklist"
POSTGRES_PORT="5432"
API_PORT="8000"
NOT_FOUND_TTL_HOURS="24"
MAX_CANDIDATES_TO_FETCH="4"
