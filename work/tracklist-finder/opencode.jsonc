{
  "$schema": "https://opencode.ai/config.json",

  // Projekt-Config, wird zusätzlich zur globalen (~/.config/opencode/opencode.jsonc) geladen.
  // Provider (kisski = SAIA, openrouter, …) und MCP-Server (brave-search, firecrawl) kommen aus der globalen Config.
  "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",  // Gemini API (GEMA-Schlüssel); Vergleich: eval/ladder.md, eval/vision-ladder.md


  // Gemini API mit dem GEMA-Schlüssel über Googles OpenAI-kompatiblen Endpunkt.
  // (Der eingebaute google-Provider von opencode bekam am 20.11. trotz gültigem Schlüssel „spending cap exceeded“.)
  "providers": {
    "gema": {
      "name": "Gemini API (GEMA)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:GEMA_GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash (GEMA)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro (GEMA)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-4-argon": {
          "name": "Gemini 4 Argon (GEMA)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "gemini-4-hydrogen": {
          "name": "Gemini 4 Hydrogen (GEMA)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-4-neon": {
          "name": "Gemini 4 Neon (GEMA)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-4-carbon": {
          "name": "Gemini 4 Carbon (GEMA)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  // keine Hintergrund-Modellaufrufe für Titel/Zusammenfassungen (spart SAIA-Requests)
  "agents": { "title": { "disabled": true }, "summary": { "disabled": true } },

  // Agent wartet nie auf Freigaben; .env bleibt tabu (Keys gehören nicht in den Modellkontext)
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "deny" }
  ]
}
