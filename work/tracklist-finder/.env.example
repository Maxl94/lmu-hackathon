# Copy to .env and fill in. Never commit .env.

# Required
OPENROUTER_API_KEY=          # research agent (DeepSeek v4.1 Flash via OpenRouter in opencode)
ANTHROPIC_API_KEY=           # judge (claude-haiku-5-5), fallback when Gemini is capped
GEMA_GEMINI_API_KEY=         # image reading (gemini-3.8-flash@low) and escalation (gema/gemini-4-hydrogen)
BRAVE_SEARCH_API_KEY=        # web search (tl-search)

# Optional
DISCOGS_USER_TOKEN=          # Discogs API: 60 instead of 25 requests/min
GENIUS_ACCESS_TOKEN=         # credits from Genius
LASTFM_API_KEY=              # community cross-check
FIRECRAWL_API_KEY=           # scraping fallback for JS-heavy pages
MUSICBRAINZ_USER_AGENT=      # e.g. "tracklist-finder/0.1 (contact)" – MusicBrainz asks for one
SCRAPER_USER_AGENT=

# Model overrides (defaults shown)
# JUDGE_MODEL=claude-haiku-5-5
# TL_VISION_MODEL=gemini-3.8-flash@low
